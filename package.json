{
  "name": "minotaur-cli",
  "version": "0.3.0",
  "description": "Runs your security scanners, hides the noise, asks a model whether a finding is exploitable, and fixes it on a branch.",
  "license": "MIT",
  "keywords": [
    "security",
    "sast",
    "sca",
    "scanner",
    "vulnerability",
    "triage",
    "cli",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venturi-sh/minotaur-cli.git"
  },
  "homepage": "https://github.com/venturi-sh/minotaur-cli#readme",
  "bugs": {
    "url": "https://github.com/venturi-sh/minotaur-cli/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "minotaur": "dist/minotaur.js"
  },
  "files": [
    "dist/minotaur.js"
  ],
  "scripts": {
    "build": "tsup",
    "minotaur": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@inkjs/ui": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "ai": "^7.0.107",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  }
}
