{
  "name": "minotaur",
  "version": "0.1.0",
  "private": true,
  "description": "Lists what your security scanners found and asks a model whether each finding is exploitable.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "minotaur": "./dist/minotaur.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "minotaur": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@inkjs/ui": "^2.0.0",
    "ai": "^7.0.107",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
